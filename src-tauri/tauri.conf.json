{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KIBT-AMS",
  "version": "2.0.0",
  "identifier": "ke.go.kibt.ams",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "KIBT Attendance Management System",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' https://generativelanguage.googleapis.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "wix": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-dev"
        ]
      }
    },
    "resources": []
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kibt-ict/kibt-ams/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}